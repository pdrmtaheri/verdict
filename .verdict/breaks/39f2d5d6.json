[
  {
    "enforcer": ".verdict/no-eval.sh",
    "description": "jobs() in src/limit.ts calls eval() on an env-supplied string",
    "edits": [
      {
        "path": "src/limit.ts",
        "find": "export function jobs(): number {",
        "replace": "export function jobs(): number {\n  eval(process.env.VERDICT_JOBS_EXPR ?? \"1\");"
      }
    ]
  }
]
